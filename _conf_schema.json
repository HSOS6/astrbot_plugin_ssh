{
    "host": {
        "description": "SSH 主机地址(必填)‼️",
        "type": "string",
        "default": "192.168.1.128",
        "hint": "服务器 IP 或域名，例如: 192.168.1.114",
        "obvious_hint": true
    },
    "port": {
        "description": "SSH 端口",
        "type": "int",
        "default": 22,
        "hint": "默认一般为 22"
    },
    "username": {
        "description": "SSH 用户名(必填)‼️",
        "type": "string",
        "default": "root",
        "hint": "登录服务器的用户名",
        "obvious_hint": true
    },
    "password": {
        "description": "SSH 密码",
        "type": "string",
        "default": "123456",
        "hint": "登录密码（明文存储，请注意安全；若使用密钥登录则可不填）",
        "obvious_hint": true
    },
    "private_key": {
        "description": "SSH 私钥内容",
        "type": "text",
        "default": "",
        "hint": "用于密钥登录的私钥内容（PEM 格式，以 -----BEGIN ... 开头）。若填写则优先使用密钥登录。",
        "obvious_hint": false
    },
    "timeout": {
        "description": "连接超时时间（秒）",
        "type": "int",
        "default": 10,
        "hint": "SSH 连接超时"
    },
    "idle_timeout": {
        "description": "闲置断开时间（分钟）",
        "type": "int",
        "default": 30,
        "hint": "SSH 会话无操作自动断开的时间（分钟）"
    },
    "log_size": {
        "description": "日志记录条数",
        "type": "int",
        "default": 5,
        "hint": "使用 /ssh log 指令时显示的最近命令执行记录条数"
    },
    "enable_history": {
        "description": "启用历史记录",
        "type": "bool",
        "default": true,
        "hint": "是否记录命令执行历史（关闭后 /ssh log 不可用，减少敏感信息留存）"
    },
    "enable_dangerous_commands": {
        "description": "允许高危命令",
        "type": "bool",
        "default": false,
        "hint": "开启后跳过所有白名单和黑名单检查，允许执行任意命令（严重警告！慎用！！）"
    },
    "command_whitelist": {
        "description": "命令白名单",
        "type": "list",
        "default": [],
        "hint": "自定义允许直接执行的命令前缀列表，留空则使用内置默认白名单。不在白名单中的命令需要二次确认，LLM 无法自动执行。"
    },
    "max_output_bytes": {
        "description": "最大输出字节数",
        "type": "int",
        "default": 32768,
        "hint": "单次命令输出的最大读取字节数（默认 32KB），超出后截断显示"
    },
    "max_exec_time": {
        "description": "单命令最大执行时长（秒）",
        "type": "int",
        "default": 30,
        "hint": "单条命令的最大执行等待时间（秒），超时后截断输出"
    },
    "known_hosts_path": {
        "description": "known_hosts 文件路径",
        "type": "string",
        "default": "",
        "hint": "SSH known_hosts 文件绝对路径，留空则使用插件目录下的 known_hosts 文件（首次连接自动获取并保存主机密钥）"
    }
}
