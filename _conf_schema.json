{
    "host": {
        "description": "SSH 主机地址(必填)‼️",
        "type": "string",
        "default": "192.168.1.128",
        "hint": "服务器 IP 或域名，例如: 192.168.1.114",
        "obvious_hint": true
    },
    "port": {
        "description": "SSH 端口",
        "type": "int",
        "default": 22,
        "hint": "默认一般为 22"
    },
    "username": {
        "description": "SSH 用户名(必填)‼️",
        "type": "string",
        "default": "root",
        "hint": "登录服务器的用户名",
        "obvious_hint": true
    },
    "password": {
        "description": "SSH 密码",
        "type": "string",
        "default": "123456",
        "hint": "登录密码（明文存储，请注意安全；若使用密钥登录则可不填）",
        "obvious_hint": true
    },
    "private_key": {
        "description": "SSH 私钥内容",
        "type": "text",
        "default": "",
        "hint": "用于密钥登录的私钥内容（PEM 格式，以 -----BEGIN ... 开头）。若填写则优先使用密钥登录。",
        "obvious_hint": false
    },
    "timeout": {
        "description": "连接超时时间（秒）",
        "type": "int",
        "default": 10,
        "hint": "SSH 连接超时"
    },
    "idle_timeout": {
        "description": "闲置断开时间（分钟）",
        "type": "int",
        "default": 30,
        "hint": "SSH 会话无操作自动断开的时间（分钟）"
    },
    "log_size": {
        "description": "日志记录条数",
        "type": "int",
        "default": 5,
        "hint": "使用 /ssh log 指令时显示的最近命令执行记录条数"
    },
    "enable_dangerous_commands": {
        "description": "允许高危命令",
        "type": "bool",
        "default": false,
        "hint": "是否允许执行 rm -rf 等高危命令（慎用！）"
    },
    "known_hosts_path": {
        "description": "known_hosts 文件路径",
        "type": "string",
        "default": "",
        "hint": "SSH known_hosts 文件绝对路径，留空则不验证主机密钥（有中间人攻击风险）"
    }
}
